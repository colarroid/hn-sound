# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable, no trailing slash.
# Local: http://localhost:3100
# Production: set this in Vercel, not here. https://sound.thehopenation.net
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Outbound email the app sends itself, currently the note a member gets when they
# are assigned training. Supabase's own templates cover the auth emails and do not
# use this. Leave it unset and nothing is sent, everything else still works.
# Create the key at resend.com/api-keys.
RESEND_API_KEY=

# Optional. Defaults to noreply@sound.thehopenation.net, which is the verified
# sender. Must be on a domain verified in Resend.
EMAIL_FROM=

# Digits in the email verification code. Must match Supabase's
# Authentication > Providers > Email > Email OTP Length, or the boxes on the
# confirm screen will not fit the code that was actually sent. 6 to 10.
NEXT_PUBLIC_EMAIL_OTP_LENGTH=6
